{
  "name": "testmart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate:local": "wrangler d1 migrations apply testmart --local",
    "db:migrate:remote": "wrangler d1 migrations apply testmart --remote",
    "db:seed:local": "wrangler d1 execute testmart --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute testmart --remote --file=seed/seed.sql",
    "db:reset:local": "wrangler d1 execute testmart --local --file=seed/reset.sql && npm run db:seed:local",
    "deploy": "npm run build && wrangler deploy",
    "smoke:production": "node scripts/smoke-production.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prebuild": "npm run seo:generate",
    "prebuild:pages": "npm run seo:generate",
    "seo:generate": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
